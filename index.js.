
require("dotenv").config();

const {
  Client,
  GatewayIntentBits,
  REST,
  Routes,
  SlashCommandBuilder,
  EmbedBuilder,
  PermissionFlagsBits
} = require("discord.js");

const { createClient } = require("@supabase/supabase-js");

const {
  DISCORD_BOT_TOKEN,
  DISCORD_APP_ID,
  DISCORD_GUILD_ID,
  DISCORD_CHANNEL_ID,
  ADMIN_ROLE_IDS,
  SUPABASE_URL,
  SUPABASE_SERVICE_ROLE_KEY
} = process.env;

const required = {
  DISCORD_BOT_TOKEN,
  DISCORD_APP_ID,
  DISCORD_GUILD_ID,
  DISCORD_CHANNEL_ID,
  SUPABASE_URL,
  SUPABASE_SERVICE_ROLE_KEY
};

for (const [key, value] of Object.entries(required)) {
  if (!value) throw new Error(`Thiếu biến môi trường: ${key}`);
}

const ADMIN_ROLES = (ADMIN_ROLE_IDS || "")
  .split(",")
  .map(x => x.trim())
  .filter(Boolean);

const client = new Client({
  intents: [GatewayIntentBits.Guilds]
});

const supabase = createClient(
  SUPABASE_URL,
  SUPABASE_SERVICE_ROLE_KEY
);

const commands = [
  new SlashCommandBuilder()
    .setName("donhang")
    .setDescription("Xem thông tin đơn hàng")
    .addStringOption(o =>
      o.setName("id")
        .setDescription("Mã đơn hàng")
        .setRequired(true)
    ),

  new SlashCommandBuilder()
    .setName("dangxuly")
    .setDescription("Xem danh sách đơn đang xử lý"),

  new SlashCommandBuilder()
    .setName("hoanthanh")
    .setDescription("Đánh dấu đơn hàng hoàn thành")
    .addStringOption(o =>
      o.setName("id").setDescription("Mã đơn hàng").setRequired(true)
    ),

  new SlashCommandBuilder()
    .setName("huydon")
    .setDescription("Hủy đơn hàng")
    .addStringOption(o =>
      o.setName("id").setDescription("Mã đơn hàng").setRequired(true)
    )
    .addStringOption(o =>
      o.setName("lydo").setDescription("Lý do hủy").setRequired(false)
    ),

  new SlashCommandBuilder()
    .setName("thanhtoan")
    .setDescription("Xác nhận khách đã thanh toán")
    .addStringOption(o =>
      o.setName("id").setDescription("Mã đơn hàng").setRequired(true)
    ),

  new SlashCommandBuilder()
    .setName("thongke")
    .setDescription("Thống kê đơn hàng Sinek Store")
];

function isAdmin(interaction) {
  const roles = interaction.member?.roles;

  const roleIds = Array.isArray(roles)
    ? roles
    : roles?.cache?.map(role => role.id) || [];

  return (
    roleIds.some(id => ADMIN_ROLES.includes(id)) ||
    interaction.memberPermissions?.has(
      PermissionFlagsBits.Administrator
    )
  );
}

function orderEmbed(order, title = "📦 ĐƠN HÀNG SINEK STORE") {
  return new EmbedBuilder()
    .setColor(0x5865F2)
    .setTitle(title)
    .addFields(
      { name: "Mã đơn", value: String(order.id), inline: false },
      { name: "Sản phẩm", value: order.product_name || "Chưa có", inline: true },
      { name: "Danh mục", value: order.category || "Chưa có", inline: true },
      { name: "Số lượng", value: String(order.quantity || 1), inline: true },
      {
        name: "Tổng tiền",
        value: `${Number(order.total_vnd || 0).toLocaleString("vi-VN")}đ`,
        inline: true
      },
      { name: "Trạng thái", value: order.status || "pending", inline: true },
      {
        name: "Thanh toán",
        value: order.payment_status || "unpaid",
        inline: true
      },
      { name: "Tên game", value: order.game_name || "Không có", inline: true },
      { name: "Thông tin", value: order.details || "Không có", inline: false }
    )
    .setTimestamp(order.created_at ? new Date(order.created_at) : new Date())
    .setFooter({ text: "Sinek Store • Sinek Bot" });
}

async function notify(title, order) {
  try {
    const channel = await client.channels.fetch(DISCORD_CHANNEL_ID);
    if (!channel) return;

    await channel.send({
      content: title,
      embeds: [orderEmbed(order)]
    });
  } catch (error) {
    console.error("Lỗi gửi thông báo:", error.message);
  }
}

async function getOrder(id) {
  const { data, error } = await supabase
    .from("orders")
    .select("*")
    .eq("id", id)
    .maybeSingle();

  if (error) throw error;
  return data;
}

async function updateOrder(id, changes) {
  const { data, error } = await supabase
    .from("orders")
    .update(changes)
    .eq("id", id)
    .select()
    .single();

  if (error) throw error;
  return data;
}

async function registerCommands() {
  const rest = new REST({ version: "10" }).setToken(DISCORD_BOT_TOKEN);

  await rest.put(
    Routes.applicationGuildCommands(DISCORD_APP_ID, DISCORD_GUILD_ID),
    { body: commands.map(command => command.toJSON()) }
  );

  console.log("Đã đăng ký lệnh Discord!");
}

client.once("ready", async () => {
  console.log(`Sinek Bot đã online: ${client.user.tag}`);

  try {
    await registerCommands();
  } catch (error) {
    console.error("Lỗi đăng ký lệnh:", error.message);
  }

  supabase
    .channel("sinek-orders")
    .on(
      "postgres_changes",
      { event: "INSERT", schema: "public", table: "orders" },
      payload => {
        notify("🆕 CÓ ĐƠN HÀNG MỚI!", payload.new);
      }
    )
    .on(
      "postgres_changes",
      { event: "UPDATE", schema: "public", table: "orders" },
      payload => {
        const oldOrder = payload.old || {};
        const newOrder = payload.new || {};

        if (oldOrder.status !== newOrder.status) {
          notify("🔔 TRẠNG THÁI ĐƠN HÀNG ĐÃ THAY ĐỔI!", newOrder);
        }

        if (oldOrder.payment_status !== newOrder.payment_status) {
          notify("💰 TRẠNG THÁI THANH TOÁN ĐÃ THAY ĐỔI!", newOrder);
        }
      }
    )
    .subscribe();
});

client.on("interactionCreate", async interaction => {
  if (!interaction.isChatInputCommand()) return;

  try {
    const name = interaction.commandName;

    if (name === "donhang") {
      if (!isAdmin(interaction)) {
        return interaction.reply({
          content: "❌ Bạn không có quyền sử dụng lệnh này!",
          ephemeral: true
        });
      }

      const order = await getOrder(interaction.options.getString("id"));

      if (!order) {
        return interaction.reply({
          content: "Không tìm thấy đơn hàng!",
          ephemeral: true
        });
      }

      return interaction.reply({
        embeds: [orderEmbed(order)],
        ephemeral: true
      });
    }

    if (name === "dangxuly") {
      if (!isAdmin(interaction)) {
        return interaction.reply({
          content: "❌ Bạn không có quyền!",
          ephemeral: true
        });
      }

      const { data, error } = await supabase
        .from("orders")
        .select("*")
        .in("status", ["pending", "processing"])
        .order("created_at", { ascending: false })
        .limit(10);

      if (error) throw error;

      if (!data.length) {
        return interaction.reply({
          content: "Hiện không có đơn đang chờ hoặc đang xử lý.",
          ephemeral: true
        });
      }

      return interaction.reply({
        content: `📋 Có ${data.length} đơn hàng:`,
        embeds: data.slice(0, 10).map(order => orderEmbed(order)),
        ephemeral: true
      });
    }

    if (name === "hoanthanh" || name === "huydon" || name === "thanhtoan") {
      if (!isAdmin(interaction)) {
        return interaction.reply({
          content: "❌ Bạn không có quyền!",
          ephemeral: true
        });
      }

      const id = interaction.options.getString("id");
      const order = await getOrder(id);

      if (!order) {
        return interaction.reply({
          content: "Không tìm thấy đơn hàng!",
          ephemeral: true
        });
      }

      let changes = {};
      let message = "";

      if (name === "hoanthanh") {
        changes = { status: "completed" };
        message = "✅ Đã đánh dấu đơn hàng hoàn thành!";
      }

      if (name === "huydon") {
        changes = { status: "cancelled" };
        const reason = interaction.options.getString("lydo");
        if (reason) changes.admin_note = reason;
        message = "❌ Đã hủy đơn hàng!";
      }

      if (name === "thanhtoan") {
        changes = { payment_status: "paid" };
        message = "💰 Đã xác nhận thanh toán!";
      }

      const updated = await updateOrder(id, changes);

      return interaction.reply({
        content: message,
        embeds: [orderEmbed(updated)],
        ephemeral: true
      });
    }

    if (name === "thongke") {
      if (!isAdmin(interaction)) {
        return interaction.reply({
          content: "❌ Bạn không có quyền!",
          ephemeral: true
        });
      }

      const { data, error } = await supabase
        .from("orders")
        .select("status,total_vnd,payment_status");

      if (error) throw error;

      const total = data.length;
      const pending = data.filter(x => x.status === "pending").length;
      const processing = data.filter(x => x.status === "processing").length;
      const completed = data.filter(x => x.status === "completed").length;
      const cancelled = data.filter(x => x.status === "cancelled").length;
      const revenue = data
        .filter(x => x.payment_status === "paid")
        .reduce((sum, x) => sum + Number(x.total_vnd || 0), 0);

      const embed = new EmbedBuilder()
        .setColor(0x57F287)
        .setTitle("📊 THỐNG KÊ SINEK STORE")
        .addFields(
          { name: "Tổng đơn", value: String(total), inline: true },
          { name: "Chờ xử lý", value: String(pending), inline: true },
          { name: "Đang xử lý", value: String(processing), inline: true },
          { name: "Hoàn thành", value: String(completed), inline: true },
          { name: "Đã hủy", value: String(cancelled), inline: true },
          {
            name: "Doanh thu đã thanh toán",
            value: `${revenue.toLocaleString("vi-VN")}đ`,
            inline: false
          }
        )
        .setTimestamp();

      return interaction.reply({ embeds: [embed], ephemeral: true });
    }
  } catch (error) {
    console.error(error);

    const message = "❌ Có lỗi xảy ra: " + error.message;

    if (interaction.replied || interaction.deferred) {
      await interaction.followUp({ content: message, ephemeral: true });
    } else {
      await interaction.reply({ content: message, ephemeral: true });
    }
  }
});

client.login(DISCORD_BOT_TOKEN);
